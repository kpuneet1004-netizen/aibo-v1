APP_NAME=Aibo
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data

# Use "stub" for deterministic local/CI tests.
# Use "openai_compatible" for a real model endpoint.
LLM_PROVIDER=stub
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-mini

# Required when APP_ENV=production. Used once to establish a phone session.
AIBO_API_KEY=
SESSION_TTL_SECONDS=86400
